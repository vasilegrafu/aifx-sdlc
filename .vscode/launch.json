{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: debug current py file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/solution.school",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONPATH": "${workspaceFolder}/solution.school" }
    },

    {
      "name": "debug solution.school/webapi",
      "type": "debugpy",
      "request": "launch",
      "module": "webapi.main",
      "cwd": "${workspaceFolder}/solution.school",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": []
    },

    {
      "name": "debug solution.school/webapp",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/solution.school/webapp",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"]
    },

    {
      "name": "debug solution.school/chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/solution.school/webapp",
      "sourceMaps": true
    }
  ],

  "compounds": [
    {
      "name": "debug solution.school/[webapi+webapp+chrome]",
      "configurations": [
        "debug solution.school/webapi",
        "debug solution.school/webapp",
        "debug solution.school/chrome"
      ],
      "stopAll": true
    }
  ]
}
