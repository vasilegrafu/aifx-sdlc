{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "run solution.school/webapi",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m webapi.main",
      "options": {
        "cwd": "${workspaceFolder}/solution.school"
      },
      "hide": false
    },

    {
      "type": "shell",
      "label": "export solution.school/openapi.json",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m webapi.export_openapi",
      "options": {
        "cwd": "${workspaceFolder}/solution.school"
      },
      "problemMatcher": [],
      "hide": false
    },

    {
      "type": "shell",
      "label": "run solution.school/webapp",
      "command": "npm run start",
      "options": {
        "cwd": "${workspaceFolder}/solution.school/webapp"
      },
      "hide": false
    },

    {
      "type": "shell",
      "label": "run solution.school/chrome",
      "command": "start http://localhost:5173",
      "hide": false
    },

    {
      "type": "shell",
      "label": "run solution.school/[webapi+webapp+chrome]",
      "dependsOn": [
        "run solution.school/webapi",
        "run solution.school/webapp",
        "run solution.school/chrome"
      ],
      "problemMatcher": []
    }
  ]
}
