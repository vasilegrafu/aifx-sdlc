{
    "editor.minimap.enabled": false,

    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true
    },

    // ENVIRONMENT is gone from here on purpose: solution.school/environment.json is
    // the single source of truth, and nothing reads the variable any more.
    // Change it by editing that file.
    //
    // PYTHONPATH stays -- it solves a different problem, putting the
    // application root on sys.path so a file can be run by path at all.
    "terminal.integrated.env.windows": {
        "PYTHONPATH": "${env:PYTHONPATH};${workspaceFolder}/solution.school"
    },

    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

    "python.testing.cwd": "${workspaceFolder}/solution.school",
    "python.testing.pytestArgs": [
        "."
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true
}
